#Replace the Genus "g__" with ""
tax_table_df$Genus <- str_replace(tax_table_df$Genus,"g__","")
#Replace the species "s__" with ""
tax_table_df$Species <- str_replace(tax_table_df$Species,"s__","")
library(tidyverse)
library(stringi)
#Get the taxonomy table for all asvs
tax_table_df <- ps@tax_table %>% as.data.frame()
#Replace the Kingdom "d__" with ""
tax_table_df$Kingdom <- str_replace(tax_table_df$Kingdom,"d__","")
#Replace the Phylum "p__" with ""
tax_table_df$Phylum <- str_replace(tax_table_df$Phylum,"p__","")
#Replace the Class "c__" with ""
tax_table_df$Class <- str_replace(tax_table_df$Class,"c__","")
#Replace the Order "o__" with ""
tax_table_df$Order <- str_replace(tax_table_df$Order,"o__","")
#Replace the Family "f__" with ""
tax_table_df$Family <- str_replace(tax_table_df$Family,"f__","")
#Replace the Genus "g__" with ""
tax_table_df$Genus <- str_replace(tax_table_df$Genus,"g__","")
#Replace the species "s__" with ""
tax_table_df$Species <- str_replace(tax_table_df$Species,"s__","")
tax_table_df <- tax_table_df[,-ncol(tax_table_df)]
otu_matrix_t <- ps@otu_table %>% as.data.frame() %>% t
final_table_df <- as.data.frame(cbind(tax_table_df,otu_matrix_t))
final_table_df
write.table(final_table_df, file="../Results/OTU_Matrix.csv",row.names = T, col.names = T, quote=F, sep=",")
#Abundance of bacteria
na_family_asvs <- which(is.na(ps.prop@tax_table[,5]))
#remove_na <- setdiff(colnames(ps@otu_table),colnames(ps@otu_table)[na_class_asvs])
remove_na <- setdiff(colnames(ps@otu_table),colnames(ps@otu_table)[na_family_asvs])
ps.top20 <- transform_sample_counts(ps, function(OTU) OTU/sum(OTU))
ps.top20 <- prune_taxa(remove_na, ps.top20)
abundance_plot <- plot_bar(ps.top20, x="sample_Class", fill="Class")+xlab("Class")+ylab("Abundance")+
theme(axis.text = element_text(size=16), axis.title = element_text(size=20), legend.text = element_text(size=14))
ggsave(filename="../Results/Abundance_Plot_GreenGenes_class_def.pdf",plot = abundance_plot, device = pdf(), width=8, height=6, units="in")
dev.off()
save(ps,ps.prop,file="../Results/phyloseq.RData")
