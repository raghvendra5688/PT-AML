#Downstream differential analysis
library(ggpicrust2)
subset_metadata_df
library(ggpicrust2)
model = "Class"
formula = as.formula(paste("", model, sep = " ~ " ))
mm <- model.matrix(object = formula, subset_metadata_df)
EC = p2EC %>%
as.data.frame() %>%
dplyr::select(-`description`) %>%
mutate(across(everything(), as.numeric))
#Perform differential abundance analysis for EC
EC_glm_x <- aldex.clr(EC, mm, mc.samples=128, denom="all", verbose=F)
EC_glm_test <- aldex.glm(EC_glm_x, mm) # slow step
EC_glm_effect <- aldex.glm.effect(EC_glm_x)
#Check estimated effect size
hist(EC_glm_effect[["ClassTumor"]]$effect, breaks = 20, xlab = "effect size", col = "yellow", main = "EC")
pdf("../Results/Picrust2_EC_MW_Plot.pdf",height = 8, width=8, pointsize=14)
ec_mw_plot <- aldex.plot(EC_glm_effect[["ClassTumor"]], type = "MW", test = "effect",
cutoff=1,all.cex = 0.4, rare.cex = 0.4, called.cex = 0.6,
xlab = "Dispersion", ylab = "Difference")
title(main = "(EC) MW Plot")
dev.off()
aldex.plot(EC_glm_effect[["ClassTumor"]], type = "MA", test = "effect",
cutoff=1,all.cex = 0.4, rare.cex = 0.4, called.cex = 0.6,
xlab = "Dispersion", ylab = "Difference")
title(main = "(EC) MA Plot")
#Make the MA plot for EC
pdf("../Results/Picrust2_EC_MA_Plot.pdf",height = 8, width=8, pointsize=14)
aldex.plot(EC_glm_effect[["ClassTumor"]], type = "MA", test = "effect",
cutoff=1,all.cex = 0.4, rare.cex = 0.4, called.cex = 0.6,
xlab = "Dispersion", ylab = "Difference")
title(main = "(EC) MA Plot")
dev.off()
plot(EC_glm_effect[["ClassTumor"]]$effect, -log10(EC_glm_test$`ClassTumor:pval`),
cex = 0.4, col = "blue", pch = 19,
xlab = "Effect size", ylab = "-log(P-value)", main = "(EC) Effect size plot")
points(EC_glm_effect[["ClassTumor"]]$effect, -log10(EC_glm_test$`ClassTumor:pval.padj`),
cex = 0.5, col = "red", pch = 19)
abline(h = -log10(0.05), lty = 2, col = "grey")
legend("topright", legend = c("-log10(P-value)", "-log10(BH-adjusted)"), pch = 19, col = c("blue", "red"))
pdf("../Results/Picrust2_EC_Volcano_Plot.pdf",height=8, width=8, pointsize=14)
plot(EC_glm_effect[["ClassTumor"]]$effect, -log10(EC_glm_test$`ClassTumor:pval`),
cex = 0.4, col = "blue", pch = 19,
xlab = "Effect size", ylab = "-log(P-value)", main = "(EC) Effect size plot")
points(EC_glm_effect[["ClassTumor"]]$effect, -log10(EC_glm_test$`ClassTumor:pval.padj`),
cex = 0.5, col = "red", pch = 19)
abline(h = -log10(0.05), lty = 2, col = "grey")
legend("topright", legend = c("-log10(P-value)", "-log10(BH-adjusted)"), pch = 19, col = c("blue", "red"))
dev.off()
significant_EC <- EC_glm_test[EC_glm_test$'ClassTumor:pval' < 0.01,]
significant_EC_effect <- EC_glm_effect$ClassTumor[rownames(significant_EC),]
significant_EC_description <- as.data.frame(p2EC)$description[rownames(p2EC) %in% rownames(significant_EC)]
EC_Tumor_sign <- cbind(description = significant_EC_description, significant_EC, significant_EC_effect)
significant_EC_description
significant_EC
EC_glm_test
EC_glm_effect
p2EC
write.table(EC_Tumor_sign, file="../Results/Picrust2_EC_Differential_Abundance.csv",row.names=T,col.names=T, quote=F, sep="\t")
