#if (!requireNamespace("BiocManager", quietly=TRUE))
#  install.packages("BiocManager")
#BiocManager::install("dada2")
library(dada2)
library(ggplot2)
library(data.table)
setwd(".")
path <- "/home/raghvendra/TII/Projects/Zainab/Data/"
all_files <- list.files(path)
# Forward fastq filenames have format: SAMPLENAME.fastq
fnFs <- sort(list.files(path, pattern=".fastq", full.names = TRUE))
sample.names <- sapply(strsplit(basename(fnFs), "_"), `[`, 1)
#Plot quality of reads from two single ended reads
pdf("../Results/QualityPlot_trn_length_def.pdf",height = 10, width = 10)
plotQualityProfile(fnFs[1:5])
dev.off()
# Place filtered files in filtered/ subdirectory
filtFs <- file.path(path, "filtered", paste0(sample.names, "_F_filt.fastq.gz"))
names(filtFs) <- sample.names
#Filter and Trim
out <- filterAndTrim(fnFs, filtFs,
maxN=0, maxEE=2, truncQ=2, rm.phix=TRUE,
compress=TRUE, multithread=TRUE) # On Windows set multithread=FALSE
head(out)
write.table(out,file="../Results/Reads_Before_And_After_Trimming_trn_length_def.csv",row.names=T, col.names=T, quote=F, sep=",")
#Lear error rates
errF <- learnErrors(filtFs, multithread=TRUE)
#Plot error rates
pdf("../Results/Error_Rates_trn_length_def.pdf",height=10, width=10)
plotErrors(errF, nominalQ=TRUE)
dev.off()
#Perform sample inference
dadaFs <- dada(filtFs, err=errF, multithread=TRUE)
#Construct sequence table
seqtab <- makeSequenceTable(dadaFs)
dim(seqtab)
table(nchar(getSequences(seqtab)))
#Remove chimeras
seqtab.nochim <- removeBimeraDenovo(seqtab, method="consensus", multithread=TRUE, verbose=TRUE)
dim(seqtab.nochim)
sum(seqtab.nochim)/sum(seqtab)
#Track read count at each step of pipeline
getN <- function(x) sum(getUniques(x))
track <- cbind(out, sapply(dadaFs, getN), rowSums(seqtab.nochim))
# If processing a single sample, remove the sapply calls: e.g. replace sapply(dadaFs, getN) with getN(dadaFs)
colnames(track) <- c("input", "filtered", "denoisedF", "nonchim")
rownames(track) <- sample.names
head(track)
write.table(track,"../Results/Reads_Tracking_trn_length_def.csv",row.names=T,col.names=T,quote=F,sep=",")
#Generate Taxa and Assign taxa and lineage
#taxa <- assignTaxonomy(seqtab.nochim, "/home/raghvendra/TII/Projects/Zainab/Data/fax/silva_nr_v132_train_set.fa.gz", multithread=TRUE, tryRC = TRUE)
#taxa <- addSpecies(taxa,"/home/raghvendra/TII/Projects/Zainab/Data/fax/silva_species_assignment_v132.fa.gz")
taxa <- assignTaxonomy(seqtab.nochim, "/home/raghvendra/TII/Projects/Zainab/Data/fax/2022.10.backbone.full-length.dada2.train.fna.gz",multithread=T,tryRC=T)
taxa <- addSpecies(taxa,"/home/raghvendra/TII/Projects/Zainab/Data/fax/2022.10.backbone.full-length.dada2.species.fna.gz")
taxa.print <- taxa # Removing sequence rownames for display only
rownames(taxa.print) <- NULL
head(taxa.print)
#Hand off to phyloseq
library(phyloseq); packageVersion("phyloseq")
library(Biostrings); packageVersion("Biostrings")
theme_set(theme_bw())
sample_data <- data.frame(Subject=sample.names, Class=c(rep("Benign",5),rep("Tumor",5)))
rownames(sample_data) <- sample.names
#Generate the phyloseq object
ps <- phyloseq(otu_table(seqtab.nochim, taxa_are_rows=FALSE),
sample_data(sample_data),
tax_table(taxa))
#Get taxa names
dna <- Biostrings::DNAStringSet(taxa_names(ps))
names(dna) <- taxa_names(ps)
ps <- merge_phyloseq(ps, dna)
#Add ASV information to phyloseq object
taxa_names(ps) <- paste0("ASV", seq(ntaxa(ps)))
ps
#Make plot for alpha-diversity
g_richness <- plot_richness(ps, x="Class", measures=c("Shannon", "Simpson"), color="Class")+theme(text=elemen_text(size=16))
ggsave(filename="../Results/Richness_Plot_GreenGenes_trn_len_def.pdf",plot = g_richness,width = 8, height = 4, units="in")
